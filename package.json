{
  "name": "demo-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "demo-app — 미니 앱 템플릿 예제 앱",
  "scripts": {
    "init": "node scripts/init-project.mjs",
    "validate:config": "node scripts/validate-config.mjs",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --env=development",
    "build:preview": "node scripts/build.mjs --env=preview",
    "build:prod": "node scripts/build.mjs --env=production",
    "seed": "node scripts/seed.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "npm run validate:config"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
